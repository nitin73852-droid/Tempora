# Backend Server Port
PORT=3001

# Allowed CORS Origins (Comma-separated or single domain)
CORS_ORIGIN=https://tempora-v2.netlify.app

# Node Environment
NODE_ENV=production

# Turso Database URL and Auth Token
TURSO_DATABASE_URL=libsql://your-turso-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Server-side AES-256-GCM Encryption Key
CHAT_ENCRYPTION_KEY=your-32-character-encryption-key

# JWT Secret Key
JWT_SECRET=your-jwt-secret-key
